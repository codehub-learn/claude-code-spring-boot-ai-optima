<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xmlns="http://maven.apache.org/POM/4.0.0"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<!-- Packaging -->
	<modelVersion>4.0.0</modelVersion>

	<!-- Versioning -->
	<artifactId>spring-ai-training</artifactId>
	<parent>
		<groupId>gr.codelearn</groupId>
		<artifactId>spring-boot-ai</artifactId>
		<version>0.0.1-SNAPSHOT</version>
	</parent>

	<!-- Meta-data -->
	<name>[${project.artifactId}]</name>
	<description>Spring AI core training module: chat, memory, RAG, and tool calling (U6-U10), plus the MCP client half of U11</description>

	<!-- Dependencies -->
	<dependencies>
		<!-- Starters are curated dependency aggregates. They carry no <version>: the reactor parent
		     (spring-boot-starter-parent 4.1.x) imports the Spring Boot BOM, which pins every managed
		     coordinate. Add a starter here, get a coherent, tested set of transitive libraries. -->

		<!-- Web MVC: REST controllers, embedded Tomcat, Jackson 3 (Boot 4 name; supersedes spring-boot-starter-web) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<!-- Observability base: Actuator health/info endpoints. The 'build' and 'git' info groups
		     light up automatically once the build-info and git-commit-id goals below produce their files. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<!-- Unit 10.4: Micrometer metrics + Micrometer Tracing over OpenTelemetry, exported by OTLP (Grafana LGTM locally). Spring AI's
		     model, embedding and vector store observations become token-usage metrics and spans through it. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-opentelemetry</artifactId>
		</dependency>

		<!-- Bean Validation (Hibernate Validator): @Valid request records at the controller boundary -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!-- OpenAPI 3 + Swagger UI: spec at /v3/api-docs, UI at /swagger-ui.html. Not Boot-BOM-managed; version pinned in the parent. -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>${springdoc-openapi.version}</version>
		</dependency>

		<!-- Spring AI on Anthropic Claude (version from the spring-ai-bom imported by the reactor parent). The starter brings
		     AnthropicChatModel (on the official Anthropic Java SDK) + its autoconfig, and transitively the provider-neutral
		     spring-ai-client-chat (ChatClient, Advisor API) and spring-ai-autoconfigure-model-chat-client (ChatClient.Builder)
		     that 6.1 declared on their own. -->
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-starter-model-anthropic</artifactId>
		</dependency>

		<!-- Spring AI on a local Ollama server (unit 7.1): OllamaChatModel + OllamaEmbeddingModel and their autoconfig. Both providers are
		     on the classpath; spring.ai.model.chat in application.yml decides which ChatModel bean exists, so feature code never changes. -->
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-starter-model-ollama</artifactId>
		</dependency>

		<!-- Chat memory in the database (unit 9.2): JdbcChatMemoryRepository (Oracle dialect included) and its autoconfig, plus
		     spring-boot-starter-jdbc (DataSource, JdbcTemplate) transitively. The schema is Flyway's, not the library's (see
		     application.yml). -->
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-starter-model-chat-memory-repository-jdbc</artifactId>
		</dependency>

		<!-- Oracle AI Vector Search as the Spring AI VectorStore (unit 10.1): OracleVectorStore + its autoconfig, on this module's
		     datasource. The starter also pulls ojdbc11 + UCP (+ simplefan); excluded because ojdbc17 (below) is this module's driver,
		     two Oracle drivers would put the same oracle.jdbc classes on the classpath twice, and Hikari is the pool. -->
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-starter-vector-store-oracle</artifactId>
			<exclusions>
				<exclusion>
					<groupId>com.oracle.database.jdbc</groupId>
					<artifactId>ojdbc11</artifactId>
				</exclusion>
				<exclusion>
					<groupId>com.oracle.database.jdbc</groupId>
					<artifactId>ucp</artifactId>
				</exclusion>
				<exclusion>
					<groupId>com.oracle.database.ha</groupId>
					<artifactId>simplefan</artifactId>
				</exclusion>
			</exclusions>
		</dependency>

		<!-- QuestionAnswerAdvisor (unit 10.1): retrieval + context as an Advisor. In Spring AI 2.0 the artifact is
		     spring-ai-vector-store-advisor (1.x / early 2.0 milestones: spring-ai-advisors-vector-store). -->
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-vector-store-advisor</artifactId>
		</dependency>

		<!-- MarkdownDocumentReader (unit 10.2): parses Markdown (commonmark) into one Document per heading section, the structure-aware
		     chunking strategy compared against TokenTextSplitter (Spring AI core) and whole documents. -->
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-markdown-document-reader</artifactId>
		</dependency>

		<!-- Spring Data JDBC (unit 9.2): the conversation registry, a single-table aggregate. Plain JDBC mapping is enough for one table;
		     no JPA / Hibernate in this module. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jdbc</artifactId>
		</dependency>

		<!-- Oracle JDBC driver, runtime only. ojdbc17 is the JDK 17+ build; version from the Boot BOM (oracle-database.version). -->
		<dependency>
			<groupId>com.oracle.database.jdbc</groupId>
			<artifactId>ojdbc17</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- Flyway: SQL-first migrations in src/main/resources/db/migration, applied manually with the flyway-maven-plugin (see <build>)
		     and by Boot only under the test profile. Boot 4 keeps Flyway's autoconfig in spring-boot-flyway (it pulls flyway-core);
		     Flyway 10+ ships the Oracle dialect separately. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-oracle</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- DevTools: automatic restart + LiveReload while developing. optional=true so it never leaks onto a
		     downstream classpath; Boot also disables it automatically in a fully packaged jar. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>

		<!-- Testing: JUnit 5, AssertJ, Spring Boot test slices, MockMvcTester -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Web MVC test slice. Boot 4.1 keeps @WebMvcTest / @AutoConfigureMockMvc / MockMvcTester in
		     their own module - spring-boot-starter-test does NOT pull it. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Testcontainers (unit 9.2): with a datasource on the classpath every @SpringBootTest needs a database, so the full-context
		     tests run against a throwaway Oracle (gvenzl/oracle-free). @ServiceConnection wires spring.datasource.*; versions from
		     the Testcontainers BOM that the Boot BOM imports (2.x module names). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-oracle-free</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<!-- Plugins -->
		<plugins>
			<!-- spring-boot-maven-plugin: `spring-boot:run` (dev), `repackage` (executable layered jar, bound to
			     `package` by the parent), `spring-boot:build-image` (OCI image via Cloud Native Buildpacks, no Dockerfile) -->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<!-- Layered jar: splits deps / snapshot deps / app into layers that cache well in image builds -->
					<layers>
						<enabled>true</enabled>
					</layers>
					<mainClass>gr.codelearn.springbootai.ai.AiTrainingApplication</mainClass>
				</configuration>
				<executions>
					<!-- build-info goal: writes META-INF/build-info.properties (group, artifact, version, build time);
					     Actuator's BuildInfoContributor surfaces it under /actuator/info -> "build" -->
					<execution>
						<id>build-info</id>
						<goals>
							<goal>build-info</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<!-- maven-failsafe-plugin: runs *IT classes in the integration-test phase and fails the build in
			     verify. Version, the integration-test/verify executions and config are inherited from the Boot
			     parent's pluginManagement; listing it here just switches it on. Surefire still runs *Test. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
			</plugin>

			<!-- git-commit-id-maven-plugin: version + `revision` execution + git.properties config are all inherited
			     from the Boot parent's pluginManagement; listing it here just switches it on. Writes
			     target/classes/git.properties, which Actuator's GitInfoContributor surfaces under /actuator/info -> "git" -->
			<plugin>
				<groupId>io.github.git-commit-id</groupId>
				<artifactId>git-commit-id-maven-plugin</artifactId>
			</plugin>

			<!-- flyway-maven-plugin (unit 9.2): migrations are applied manually, never on app boot (spring.flyway.enabled=false in
			     application.yml; the test profile re-enables Boot's Flyway for its Testcontainers database). With compose Oracle up:
			       ./mvnw -pl spring-ai-training flyway:migrate      apply the migrations
			       ./mvnw -pl spring-ai-training flyway:info         show applied / pending state
			     The schema is this module's own Oracle user, ai_training (created by compose/oracle-startdb), not spring-boot-training's
			     `training`: two Flyway histories never share a schema, and a flyway:clean here cannot drop the other module's tables.
			     No <executions>, so a normal build never runs it. Driver and dialect are plugin dependencies (not covered by the BOM);
			     their versions reuse the Boot BOM properties. -->
			<plugin>
				<groupId>org.flywaydb</groupId>
				<artifactId>flyway-maven-plugin</artifactId>
				<version>${flyway.version}</version>
				<configuration>
					<url>jdbc:oracle:thin:@//localhost:1521/FREEPDB1</url>
					<user>ai_training</user>
					<password>ai_training</password>
					<locations>
						<location>filesystem:${project.basedir}/src/main/resources/db/migration</location>
					</locations>
				</configuration>
				<dependencies>
					<dependency>
						<groupId>com.oracle.database.jdbc</groupId>
						<artifactId>ojdbc17</artifactId>
						<version>${oracle-database.version}</version>
					</dependency>
					<dependency>
						<groupId>org.flywaydb</groupId>
						<artifactId>flyway-database-oracle</artifactId>
						<version>${flyway.version}</version>
					</dependency>
				</dependencies>
			</plugin>
		</plugins>
	</build>

	<!-- Profiles: `local` is active unless another profile is explicitly selected (activeByDefault is
	     disabled the moment you pass -P<other>); `ci` activates on its own whenever the CI environment
	     variable is present. Both only set the Spring profile that `spring-boot:run` starts with. -->
	<profiles>
		<profile>
			<id>local</id>
			<activation>
				<activeByDefault>true</activeByDefault>
			</activation>
			<properties>
				<spring-boot.run.profiles>local</spring-boot.run.profiles>
			</properties>
		</profile>
		<profile>
			<id>ci</id>
			<activation>
				<property>
					<name>env.CI</name>
				</property>
			</activation>
			<properties>
				<spring-boot.run.profiles>test</spring-boot.run.profiles>
			</properties>
		</profile>
	</profiles>
</project>