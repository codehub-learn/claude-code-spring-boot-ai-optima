<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xmlns="http://maven.apache.org/POM/4.0.0"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<!-- Packaging -->
	<modelVersion>4.0.0</modelVersion>

	<!-- Versioning -->
	<artifactId>spring-boot-persistence-demo</artifactId>
	<parent>
		<groupId>gr.codelearn</groupId>
		<artifactId>spring-boot-ai</artifactId>
		<version>0.0.1-SNAPSHOT</version>
	</parent>

	<!-- Meta-data -->
	<name>[${project.artifactId}]</name>
	<description>Spring Boot persistence demo: Spring Data JPA, Flyway migrations and Oracle 23ai</description>

	<!-- Dependencies -->
	<dependencies>
		<!-- Persistence: Spring Data JPA over Hibernate 7 (HikariCP, spring-orm, spring-tx transitively) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<!-- Lombok: compile-time only -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
		</dependency>

		<!-- MapStruct: entity -> response record mappers. The processor itself is wired in the parent compiler plugin (annotationProcessorPaths:
		     Lombok, lombok-mapstruct-binding, MapStruct, in that order); this is the annotation API. Version is not managed by Spring Boot. -->
		<dependency>
			<groupId>org.mapstruct</groupId>
			<artifactId>mapstruct</artifactId>
			<version>${mapstruct.version}</version>
		</dependency>

		<!-- Oracle JDBC driver (runtime only); ojdbc17 is the JDK 17+ build -->
		<dependency>
			<groupId>com.oracle.database.jdbc</groupId>
			<artifactId>ojdbc17</artifactId>
			<scope>runtime</scope>
		</dependency>
	</dependencies>

	<build>
		<!-- Plugins -->
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<excludeGroupIds>
						org.projectlombok,org.mapstruct
					</excludeGroupIds>
					<layers>
						<enabled>true</enabled>
					</layers>
					<mainClass>gr.codelearn.springbootai.persistencedemo.PersistenceDemoApplication</mainClass>
				</configuration>
			</plugin>

			<!-- flyway-maven-plugin: migrations are applied manually, never on app boot. Against the compose.yaml Oracle:
			       ./mvnw -pl spring-boot-persistence-demo flyway:migrate@create-schema   once, as SYSTEM: creates the DROMEAS schema
			       ./mvnw -pl spring-boot-persistence-demo flyway:migrate                 DDL + baseline seed + bulk data, as DROMEAS
			       ./mvnw -pl spring-boot-persistence-demo flyway:info | flyway:validate
			     The bulk data is repeatable scripts in db/migration (no separate db/demo location), so it is applied everywhere the
			     schema is. The create-schema execution uses its own history table and the db/admin location. Versions track
			     flyway-core via the Boot BOM property. -->
			<plugin>
				<groupId>org.flywaydb</groupId>
				<artifactId>flyway-maven-plugin</artifactId>
				<version>${flyway.version}</version>
				<configuration>
					<url>jdbc:oracle:thin:@//localhost:1521/FREEPDB1</url>
					<user>dromeas</user>
					<password>dromeas</password>
					<locations>
						<location>filesystem:${project.basedir}/src/main/resources/db/migration</location>
					</locations>
				</configuration>
				<executions>
					<execution>
						<id>create-schema</id>
						<configuration>
							<user>system</user>
							<password>oracle</password>
							<table>flyway_schema_history_admin</table>
							<!-- SYSTEM already holds Oracle's own objects, so Flyway needs an explicit baseline before V1 -->
							<baselineOnMigrate>true</baselineOnMigrate>
							<baselineVersion>0</baselineVersion>
							<locations>
								<location>filesystem:${project.basedir}/src/main/resources/db/admin</location>
							</locations>
						</configuration>
					</execution>
				</executions>
				<dependencies>
					<dependency>
						<groupId>com.oracle.database.jdbc</groupId>
						<artifactId>ojdbc17</artifactId>
						<version>${oracle-database.version}</version>
					</dependency>
					<dependency>
						<groupId>org.flywaydb</groupId>
						<artifactId>flyway-database-oracle</artifactId>
						<version>${flyway.version}</version>
					</dependency>
				</dependencies>
			</plugin>
		</plugins>
	</build>
</project>