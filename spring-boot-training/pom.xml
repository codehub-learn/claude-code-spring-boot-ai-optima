<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xmlns="http://maven.apache.org/POM/4.0.0"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<!-- Packaging -->
	<modelVersion>4.0.0</modelVersion>

	<!-- Versioning -->
	<artifactId>spring-boot-training</artifactId>
	<parent>
		<groupId>gr.codelearn</groupId>
		<artifactId>spring-boot-ai</artifactId>
		<version>0.0.1-SNAPSHOT</version>
	</parent>

	<!-- Meta-data -->
	<name>[${project.artifactId}]</name>
	<description>Spring Boot fundamentals training module: project setup, DI and beans, persistence, and REST APIs</description>

	<!-- Dependencies -->
	<dependencies>
		<!-- Starters are curated dependency aggregates. They carry no <version>: the reactor parent
		     (spring-boot-starter-parent 4.1.x) imports the Spring Boot BOM, which pins every managed
		     coordinate. Add a starter here, get a coherent, tested set of transitive libraries. -->

		<!-- Web MVC: REST controllers, embedded Tomcat, Jackson 3 (Boot 4 name; supersedes spring-boot-starter-web) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<!-- Observability base: Actuator health/info endpoints. The 'build' and 'git' info groups
		     light up automatically once the build-info and git-commit-id goals below produce their files. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<!-- Bean Validation (Hibernate Validator): drives @Validated on @ConfigurationProperties and, later, on controllers -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!-- Spring AOP + AspectJ pointcut/annotation support: the @Aspect method-timing demo in
		     foundation.components (topic 2.3). Boot 4 renamed spring-boot-starter-aop to -aspectj. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-aspectj</artifactId>
		</dependency>

		<!-- Persistence (U3): Spring Data JPA over Hibernate 7. Brings HikariCP, spring-orm, spring-jdbc and
		     spring-tx transitively, plus a real JpaTransactionManager - which is what finally activates the
		     @TransactionalEventListener wired dormant in foundation.components (2.3). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<!-- Lombok: compile-time only, for the JPA @Entity classes (U3.2) - @Getter/@Setter on the mutable
		     fields, @NoArgsConstructor(PROTECTED). Records cover everything else (CLAUDE.md "Lombok vs
		     records"). The parent pom already wires lombok as an annotation-processor path; this adds it to
		     the compile classpath. optional=true keeps it off any downstream classpath, and
		     spring-boot-maven-plugin excludes org.projectlombok from the repackaged jar. Version from the BOM. -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<!-- Oracle JDBC driver (runtime only; the app compiles against JPA, not the driver). ojdbc17 is the
		     JDK 17+ build - the right one for the Java 25 toolchain and virtual threads. Version comes from
		     the Spring Boot BOM property oracle-database.version. -->
		<dependency>
			<groupId>com.oracle.database.jdbc</groupId>
			<artifactId>ojdbc17</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- Flyway: SQL-first, versioned migrations in src/main/resources/db/migration. Applied manually via the
		     flyway-maven-plugin (see <build>), NOT on app boot - except under the test profile, where Boot's
		     FlywayAutoConfiguration runs them against the throwaway Testcontainers database. Boot 4 splits every
		     integration's auto-configuration into its own module: spring-boot-flyway carries that autoconfig and
		     pulls flyway-core. Since Flyway 10 the core jar bundles no database dialects, so
		     flyway-database-oracle is required for Oracle. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-oracle</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- DevTools: automatic restart + LiveReload while developing. optional=true so it never leaks onto a
		     downstream classpath; Boot also disables it automatically in a fully packaged jar. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>

		<!-- Testing: JUnit 5, AssertJ, Spring Boot test slices, MockMvcTester -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Testcontainers: integration tests run against a real Oracle in a throwaway container
		     (gvenzl/oracle-free). spring-boot-testcontainers adds @ServiceConnection so the container wires
		     spring.datasource.* with no @DynamicPropertySource boilerplate. Versions come from the
		     Testcontainers BOM, which the Spring Boot BOM imports; in Testcontainers 2.x the module is
		     testcontainers-oracle-free. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-oracle-free</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<!-- Plugins -->
		<plugins>
			<!-- spring-boot-maven-plugin: `spring-boot:run` (dev), `repackage` (executable layered jar, bound to
			     `package` by the parent), `spring-boot:build-image` (OCI image via Cloud Native Buildpacks, no Dockerfile) -->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<!-- Compile-only processors: keep them out of the runtime classpath and the fat jar -->
					<excludeGroupIds>
						org.projectlombok,org.mapstruct
					</excludeGroupIds>
					<!-- Layered jar: splits deps / snapshot deps / app into layers that cache well in image builds -->
					<layers>
						<enabled>true</enabled>
					</layers>
					<mainClass>gr.codelearn.springbootai.training.TrainingApplication</mainClass>
				</configuration>
				<executions>
					<!-- build-info goal: writes META-INF/build-info.properties (group, artifact, version, build time);
					     Actuator's BuildInfoContributor surfaces it under /actuator/info -> "build" -->
					<execution>
						<id>build-info</id>
						<goals>
							<goal>build-info</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<!-- maven-failsafe-plugin: runs *IT classes in the integration-test phase and fails the build in
			     verify. Version, the integration-test/verify executions and config are inherited from the Boot
			     parent's pluginManagement; listing it here just switches it on. Surefire still runs *Test. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
			</plugin>

			<!-- git-commit-id-maven-plugin: version + `revision` execution + git.properties config are all inherited
			     from the Boot parent's pluginManagement; listing it here just switches it on. Writes
			     target/classes/git.properties, which Actuator's GitInfoContributor surfaces under /actuator/info -> "git" -->
			<plugin>
				<groupId>io.github.git-commit-id</groupId>
				<artifactId>git-commit-id-maven-plugin</artifactId>
			</plugin>

			<!-- flyway-maven-plugin: migrations are applied manually, never on app boot (spring.flyway.enabled=false
			     in application.yml; the test profile re-enables Boot's Flyway for its throwaway Testcontainers DB).
			     With a database running (compose.yaml Oracle, or `docker compose up -d`):
			       ./mvnw -pl spring-boot-training flyway:migrate            apply DDL + both seed tiers
			       ./mvnw -pl spring-boot-training flyway:info               show applied / pending state
			       ./mvnw -pl spring-boot-training flyway:validate           check scripts against history
			       ./mvnw -pl spring-boot-training -Dflyway.cleanDisabled=false flyway:clean   drop everything (dev only)
			     Data seeding is two-tier and both tiers apply here: R__0* baseline (db/migration) and R__9*
			     generated bulk (db/demo), both listed in <locations> below. The Testcontainers tests get the
			     baseline only, because Boot's Flyway reads spring.flyway.locations = classpath:db/migration.
			     flyway:clean is disabled by default (Flyway 10+); pass -Dflyway.cleanDisabled=false to reset.
			     No <executions>, so nothing runs during a normal build. Version tracks flyway-core via the Boot
			     BOM property. Connection defaults match compose.yaml; override with -Dflyway.url / -Dflyway.user /
			     -Dflyway.password or a flyway.conf. The Oracle JDBC driver and the Flyway Oracle module are plugin
			     dependencies (plugin dependencies are not covered by the project's BOM); their versions reuse the
			     Boot BOM properties oracle-database.version / flyway.version. -->
			<plugin>
				<groupId>org.flywaydb</groupId>
				<artifactId>flyway-maven-plugin</artifactId>
				<version>${flyway.version}</version>
				<configuration>
					<url>jdbc:oracle:thin:@//localhost:1521/FREEPDB1</url>
					<user>training</user>
					<password>training</password>
					<locations>
						<location>filesystem:${project.basedir}/src/main/resources/db/migration</location>
						<location>filesystem:${project.basedir}/src/main/resources/db/demo</location>
					</locations>
				</configuration>
				<dependencies>
					<dependency>
						<groupId>com.oracle.database.jdbc</groupId>
						<artifactId>ojdbc17</artifactId>
						<version>${oracle-database.version}</version>
					</dependency>
					<dependency>
						<groupId>org.flywaydb</groupId>
						<artifactId>flyway-database-oracle</artifactId>
						<version>${flyway.version}</version>
					</dependency>
				</dependencies>
			</plugin>
		</plugins>
	</build>

	<!-- Profiles: `local` is active unless another profile is explicitly selected (activeByDefault is
	     disabled the moment you pass -P<other>); `ci` activates on its own whenever the CI environment
	     variable is present. Both only set the Spring profile that `spring-boot:run` starts with. -->
	<profiles>
		<profile>
			<id>local</id>
			<activation>
				<activeByDefault>true</activeByDefault>
			</activation>
			<properties>
				<spring-boot.run.profiles>local</spring-boot.run.profiles>
			</properties>
		</profile>
		<profile>
			<id>ci</id>
			<activation>
				<property>
					<name>env.CI</name>
				</property>
			</activation>
			<properties>
				<spring-boot.run.profiles>test</spring-boot.run.profiles>
			</properties>
		</profile>
	</profiles>
</project>